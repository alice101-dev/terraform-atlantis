{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)"
  ],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts (HTTP repo) in gitops/controllers/*/config.yaml",
      "managerFilePatterns": ["/^gitops/controllers/[^/]+/config\\.yaml$/"],
      "matchStrings": [
        "chart: (?<depName>\\S+)\\nrepoURL: (?<registryUrl>https://\\S+)\\nversion: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Helm charts (OCI) in gitops/controllers/*/config.yaml",
      "managerFilePatterns": ["/^gitops/controllers/[^/]+/config\\.yaml$/"],
      "matchStrings": [
        "chart: (?<chart>\\S+)\\nrepoURL: (?<registry>[a-z0-9.-]+\\.[a-z]+/\\S+)\\nversion: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "{{{registry}}}/{{{chart}}}",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Atlantis Helm chart in the Atlantis ApplicationSet",
      "managerFilePatterns": ["/^gitops/appsets/atlantis\\.yaml$/"],
      "matchStrings": [
        "repoURL: (?<registryUrl>https://\\S+)\\n\\s+chart: (?<depName>\\S+)\\n\\s+targetRevision: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Gateway API CRDs (git tag)",
      "managerFilePatterns": ["/^gitops/appsets/gateway-api\\.yaml$/"],
      "matchStrings": [
        "repoURL: https://github\\.com/(?<depName>kubernetes-sigs/gateway-api)\\.git\\n\\s+targetRevision: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Argo CD charts installed by the argocd-bootstrap workspace",
      "managerFilePatterns": ["/^environments/[^/]+/argocd-bootstrap/[^/]+\\.tfvars$/"],
      "matchStrings": [
        "argocd_chart_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "argo-cd",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm",
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Argo CD apps chart installed by the argocd-bootstrap workspace",
      "managerFilePatterns": ["/^environments/[^/]+/argocd-bootstrap/[^/]+\\.tfvars$/"],
      "matchStrings": [
        "argocd_apps_chart_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "argocd-apps",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm",
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Terraform version used by the Atlantis server",
      "managerFilePatterns": ["/^gitops/atlantis/values\\.yaml$/"],
      "matchStrings": ["defaultTFVersion: (?<currentValue>v\\S+)"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Atlantis image used by the CI policy tests",
      "managerFilePatterns": ["/^\\.github/workflows/pr-checks\\.yml$/"],
      "matchStrings": [
        "ATLANTIS_IMAGE: (?<depName>ghcr\\.io/runatlantis/atlantis):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Checkov version used by CI",
      "managerFilePatterns": ["/^\\.github/workflows/pr-checks\\.yml$/"],
      "matchStrings": ["CHECKOV_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "checkov",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "TFLint version used by CI",
      "managerFilePatterns": ["/^\\.github/workflows/pr-checks\\.yml$/"],
      "matchStrings": ["TFLINT_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for all GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Terraform CLI: .terraform-version, required_version and the Atlantis server move together",
      "matchDepNames": ["hashicorp/terraform"],
      "groupName": "Terraform CLI"
    },
    {
      "description": "Terraform providers and their lock files in every workspace",
      "matchDatasources": ["terraform-provider"],
      "groupName": "Terraform providers"
    },
    {
      "description": "Atlantis chart and image (server + CI) move together",
      "matchDepNames": ["atlantis", "ghcr.io/runatlantis/atlantis"],
      "groupName": "Atlantis"
    },
    {
      "description": "Argo CD charts move together",
      "matchDepNames": ["argo-cd", "argocd-apps"],
      "groupName": "Argo CD"
    },
    {
      "description": "kgateway CRDs and controller must use the same version",
      "matchDepNames": ["/kgateway/"],
      "groupName": "kgateway"
    }
  ]
}
